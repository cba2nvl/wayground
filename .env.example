# ============================================================================
#  Wayground Console + Neko thật
#  `npm start` chạy Docker Compose: tự tải Neko và mở giao diện gốc tại :3000.
#  Chỉ dùng `npm run demo` nếu muốn xem máy ảo canvas giả lập.
# ============================================================================

# ------------------------------ Máy chủ web --------------------------------
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Mật khẩu bảo vệ trang điều khiển (để trống = không cần đăng nhập).
# Cổng Compose chỉ bind localhost mặc định; bắt buộc đặt mật khẩu nếu mở ra LAN/internet.
APP_PASSWORD=
APP_BIND_ADDRESS=127.0.0.1
NEKO_BIND_ADDRESS=127.0.0.1

# ---------------------------------------------------------------------------
#  Chế độ chạy
#    demo : máy ảo mô phỏng ngay trong trình duyệt + neko giả lập nội bộ.
#           Dùng để xem/demo toàn bộ cơ chế pause mà không cần hạ tầng.
#    live : kết nối tới neko thật (NEKO_URL bắt buộc).
#    auto : có NEKO_URL -> live, không có -> demo.
#           App và Compose mặc định chạy live; demo phải bật bằng MODE=demo.
#           `npm start` luôn dùng Compose với Neko đóng gói sẵn.
# ---------------------------------------------------------------------------
MODE=live

# ---------------------------------------------------------------------------
#  Kiểu khung xem (viewer) nhúng trong trang
#    embed  : giao diện gốc của Neko (đầy đủ tính năng: chat, clipboard,
#             chia sẻ file...), pause qua private_mode. Đây là mặc định live.
#             Yêu cầu neko bật legacy (`NEKO_LEGACY=true`) vì UI dùng `/ws`.
#    webrtc : viewer WebRTC mini tùy chọn của Wayground, pause video tại client.
#    novnc  : nhúng noVNC (nếu bạn có VNC/websockify riêng), pause qua neko.
#    demo   : máy ảo mô phỏng vẽ bằng canvas (chế độ demo).
# ---------------------------------------------------------------------------
VIEWER=auto

# ------------------------------- Kết nối neko ------------------------------
# Địa chỉ neko server (HTTP). App chạy riêng mặc định dùng http://127.0.0.1:8080.
# Compose luôn tự cấu hình http://neko:8080 bên trong mạng Docker.
NEKO_URL=http://127.0.0.1:8080
# IP mà trình duyệt sẽ gọi WebRTC trực tiếp tới. Compose dùng 127.0.0.1 cho máy local;
# đổi sang IP LAN/public khi truy cập từ thiết bị khác.
NEKO_PUBLIC_IP=127.0.0.1
# Tài khoản người dùng thường (đây là session sẽ bị pause bởi private_mode).
NEKO_USERNAME=neko
NEKO_PASSWORD=neko
# Tài khoản admin - node.js dùng để gọi các API quản trị (/api/room/settings,
# desktop reset keys...). Ở neko v3 bạn có thể dùng API token thay thế.
NEKO_ADMIN_USERNAME=admin
NEKO_ADMIN_PASSWORD=admin
# Khuyến nghị: đặt API token bên neko rồi điền vào đây.
#   neko:  NEKO_SESSION_API_TOKEN=my-secret-token   (v3, key session.api_token)
#   đây:   NEKO_API_TOKEN=my-secret-token
# Token này tạo ra một session admin "API Session" -> node.js không cần mật khẩu
# admin, và mọi lời gọi /api/room/settings/ đều hợp lệ.
NEKO_API_TOKEN=

# Tên container Docker của neko -> cho phép chiến lược "đóng băng" máy ảo
# bằng `docker pause` (tiết kiệm CPU gần như tuyệt đối khi rời chuột lâu).
NEKO_CONTAINER=
# Đường dẫn tới file thực thi docker (rootless: ~/bin/docker)
DOCKER_BIN=docker

# noVNC (chỉ khi VIEWER=novnc): URL của noVNC vnc.html hoặc vnc_lite.html
NOVNC_URL=http://localhost:6080/vnc.html
# WebSocket của websockify mà node.js sẽ proxy (tránh CORS/mixed-content)
NOVNC_WS_URL=ws://localhost:6080/websockify

# ------------------------------ Cơ chế pause --------------------------------
# Trễ trước khi pause sau khi chuột RỜI khung (ms) - chống "nhấp nháy" ở mép.
PAUSE_LEAVE_DEBOUNCE_MS=600
# Trễ trước khi resume sau khi chuột QUAY LẠI khung (ms).
PAUSE_ENTER_DEBOUNCE_MS=120
# Tự động pause khi không có thao tác chuột/bàn phím trong khung (ms, 0 = tắt)
PAUSE_IDLE_MS=0

# Bậc thang pause: soft (client) -> hard (neko private_mode) -> deep (docker)
# Sau bao lâu thì nâng lên bậc "hard" (tạm dừng phía neko server).
PAUSE_HARD_AFTER_MS=3000
# Sau bao lâu thì nâng lên bậc "deep" (docker pause container neko).
PAUSE_DOCKER_AFTER_MS=60000
# Giới hạn thời gian đóng băng container (tự bỏ đóng băng để WebRTC/DTLS
# không bị chết). 0 = không giới hạn (không khuyến khích).
PAUSE_MAX_FREEZE_MS=120000
# Tự resume nếu không nhận được tín hiệu từ trình duyệt trong khoảng này (ms).
# An toàn cho trường hợp đóng laptop/tab khi đang pause. 0 = tắt.
PAUSE_LEASE_MS=600000
# Tự resume tối đa sau bao lâu kể cả khi tab vẫn mở (ms). 0 = tắt.
PAUSE_MAX_MS=1800000

# Bật/tắt từng chiến lược
STRATEGY_CLIENT=true
STRATEGY_SERVER=true
STRATEGY_DOCKER=false
# Lấy lại quyền điều khiển chuột/bàn phím ngay khi resume
AUTO_RECLAIM_CONTROL=true

# ------------------------------- Tuỳ chọn khác ------------------------------
# Cho phép nhiều người xem: khi đó pause phải do TẤT CẢ client rời chuột
# (STRATEGY_SERVER/private_mode là thiết lập dùng chung cho cả phòng).
MULTI_CLIENT_ALL_MUST_LEAVE=true
